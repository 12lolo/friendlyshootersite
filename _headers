# Force browsers and edge to revalidate HTML so updates appear quickly
/
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Keep static assets cacheable (version querystring handles invalidation)
/css/*
  Cache-Control: public, max-age=31536000, immutable
